{
  "name": "code-in-the-dark-editor",
  "version": "2.0.0",
  "private": true,
  "description": "A blind, power-mode, single-HTML-file editor for Code in the Dark competitions",
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:prep": "vite -c vite.prep.config.ts",
    "build": "vite build && vite build -c vite.prep.config.ts && node scripts/build-practice.ts && npm run build:worker-pages",
    "build:worker-pages": "vite build -c vite.worker.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker:dev": "wrangler dev",
    "smoke": "node tests/worker/smoke.ts"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "5.3.0",
    "ace-builds": "1.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  },
  "cloudflare": {
    "bindings": {
      "ORGANIZER_KEY": {
        "description": "The secret a Host types in the Host console to claim a Competition on this Worker. Make it long and keep it to yourself: anyone who has it can claim Competitions here."
      }
    }
  }
}
